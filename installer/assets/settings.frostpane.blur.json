{
  "custom-ui-style.stylesheet": {
    ".quick-input-widget": {
      "background-color": "color-mix(in srgb, var(--vscode-quickInput-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".monaco-menu-container": {
      "background-color": "color-mix(in srgb, var(--vscode-menu-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)",
      "overflow": "visible !important"
    },
    ".monaco-menu-container .monaco-scrollable-element, .monaco-menu-container .monaco-menu, .monaco-menu-container .monaco-action-bar.vertical": {
      "background": "transparent !important",
      "background-color": "transparent !important"
    },
    ".monaco-submenu": {
      "background-color": "color-mix(in srgb, var(--vscode-menu-background), #ffffff 4%) !important",
      "overflow": "visible !important"
    },
    ".monaco-select-box-dropdown-container": {
      "background-color": "color-mix(in srgb, var(--vscode-dropdown-listBackground, var(--vscode-dropdown-background)) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".monaco-select-box-dropdown-container .select-box-dropdown-list-container, .monaco-select-box-dropdown-container .monaco-list-rows": {
      "background": "transparent !important",
      "background-color": "transparent !important"
    },
    ".notification-toast, .notifications-center": {
      "background-color": "color-mix(in srgb, var(--vscode-notifications-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".notification-toast .notifications-list-container, .notifications-center .notifications-list-container, .notification-list-item": {
      "background": "transparent !important",
      "background-color": "transparent !important"
    },
    ".monaco-editor .find-widget, .simple-find-part": {
      "background-color": "color-mix(in srgb, var(--vscode-editorWidget-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".monaco-workbench .debug-toolbar": {
      "background-color": "color-mix(in srgb, var(--vscode-debugToolBar-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".monaco-modal-editor-block .modal-editor-part": {
      "background-color": "color-mix(in srgb, var(--vscode-editorWidget-background) 45%, transparent) !important",
      "backdrop-filter": "blur(14px) saturate(1.4)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.4)"
    },
    ".command-center-center, .agent-status-pill": {
      "background": "linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.02) 55%) !important",
      "backdrop-filter": "blur(14px) saturate(1.6)",
      "-webkit-backdrop-filter": "blur(14px) saturate(1.6)",
      "box-shadow": "inset 0 0 0 1px rgba(255,255,255,0.10), inset 0 1px 0 0 rgba(255,255,255,0.20) !important"
    }
  },
  "custom-ui-style.external.imports": "__FROSTPANE_IMPORTS__"
}
